# Copia a .env (en la raíz del repo) y ajusta. Las llaves van en archivos aparte, nunca aquí.

# --- Servidor ---------------------------------------------------------------------------------
COMPANION_HOST=0.0.0.0
COMPANION_PORT=8770
COMPANION_DB=data/companion.db
COMPANION_TZ=America/Mexico_City            # tu zona horaria (la hora de la placa sale de aquí)
COMPANION_PUBLIC_URL=http://192.168.1.50:8770   # cómo ve la placa a esta máquina (para OTA)

# --- Quién es quién ---------------------------------------------------------------------------
COMPANION_NAME=Pana                         # cómo se llama el personaje
COMPANION_OWNER=                            # tu nombre (opcional: lo usa la persona del LLM)
PERSONA_FILE=                               # persona propia en texto ({nombre} y {dueno} se rellenan)

# --- Cerebro: Hermes Agent (recomendado) o un LLM local directo --------------------------------
COMPANION_BRAIN=hermes                      # hermes | local
HERMES_URL=http://127.0.0.1:8642/v1
HERMES_API_KEY_FILE=~/.config/pana/hermes-api-key
HERMES_SESSION=pana

# LLM compatible con OpenAI (llama.cpp, Ollama, LM Studio…) para lo rápido y el modo local
LLM_API_KEY_FILE=
LLM_FAST_URL=http://127.0.0.1:8081/v1
LLM_FAST_MODEL=local
LLM_CHAT_URL=http://127.0.0.1:8081/v1
LLM_CHAT_MODEL=local
LLM_BIG_URL=http://127.0.0.1:8081/v1
LLM_BIG_MODEL=local
EMBED_URL=http://127.0.0.1:8084/v1
EMBED_MODEL=qwen3-embedding-0.6b

# --- Voz ----------------------------------------------------------------------------------------
STT_URL=http://127.0.0.1:8771/inference     # whisper.cpp server
STT_VOCABULARIO=Hermes, Pana, Obsidian, homelab, YouTube, Instagram   # nombres que debe reconocer
TTS_ENGINE=piper                            # piper | http
PIPER_MODEL=voices/es_MX-claude-high.onnx
TTS_HTTP_URL=http://127.0.0.1:5002/tts      # si TTS_ENGINE=http: POST {"texto"} → PCM 16 kHz mono

# --- Autonomía ----------------------------------------------------------------------------------
HEARTBEAT_MINUTES=3
MAX_SPONTANEOUS_PER_HOUR=3
QUIET_START=22:30
QUIET_END=07:30
CONFIRM_TIMEOUT_MINUTES=5
DREAM_AT=03:00
BRIEF_AT=07:45
NEGOCIO_ADAPTER=mock                        # datos de ejemplo; escribe tu adaptador en server/tools/

# --- Tablero de la P4 (página homelab · hoy) ---------------------------------------------------
HOMELAB_NAME=                               # el nombre que sale arriba (por defecto, el hostname)
OBSIDIAN_VAULT=                             # ruta a tu vault para la página del grafo
AGENDA_ICS_URL=                             # dirección secreta iCal de tu calendario (varias, con comas)
YT_API_KEY=                                 # YouTube Data API v3
YT_CHANNEL_ID=                              # UC…
INSTAGRAM_ACCESS_TOKEN=                     # Graph API (cuenta profesional)
INSTAGRAM_BUSINESS_ACCOUNT_ID=
